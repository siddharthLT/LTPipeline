# Copy to .env for local use; set the same names in Vercel > Settings > Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SECRET_KEY=generate-a-long-random-string
DEBUG=false
# Daily digest email (Resend). CRON_SECRET must also be set so the Vercel cron can call /digest/cron/.
RESEND_KEY=re_xxxxxxxx
CRON_SECRET=generate-a-long-random-string
# Optional: DIGEST_FROM="Lunartree GTM <notifications@lunartreedata.live>", DIGEST_BASE_URL=https://lt-pipeline.vercel.app
